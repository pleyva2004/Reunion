# --- Server ---
PORT=3000

# --- Photon iMessage adapter ---
# "mock" (default, runs anywhere) or "real" (@photon-ai/advanced-imessage-kit, needs macOS + iMessage server)
PHOTON_MODE=mock
IMESSAGE_SERVER_URL=http://localhost:1234
IMESSAGE_API_KEY=

# Dedicated gRPC iMessage server (alternative to IMESSAGE_SERVER_URL)
IMESSAGE_GRPC_ADDRESS=
IMESSAGE_GRPC_TOKEN=
IMESSAGE_GRPC_TLS=false

# Dev group chat for npm run send-poll:dev (auto-resolved by name if unset)
DEV_CHAT_GUID=

# --- Inbound group-chat messages ---
# disabled | spectrum-local | spectrum-cloud | webhook
# Auto when unset: spectrum-local if PHOTON_MODE=real; webhook if SPECTRUM_SIGNING_SECRET set
INBOUND_MODE=

# --- Spectrum (cloud webhook or SDK loop) ---
# From app.photon.codes or: photon login && photon projects create --name Reunion --spectrum
PROJECT_ID=
PROJECT_SECRET=
SPECTRUM_SIGNING_SECRET=

# --- Intent gate (tunable) ---
INTENT_CONFIDENCE_THRESHOLD=0.6

# --- Poll completion (close poll + emit roster) ---
# All voted -> immediate. Otherwise close after this timeout (default 24h).
COMPLETION_TIMEOUT_MS=86400000

# --- Butterbase (state) ---
BUTTERBASE_APP_ID=
BUTTERBASE_API_KEY=
BUTTERBASE_BASE_URL=
