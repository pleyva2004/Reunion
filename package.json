{
  "name": "reunion",
  "version": "0.1.0",
  "private": true,
  "description": "Group Travel Planning Agent — intent → availability poll → user roster (iMessage)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:live": "PHOTON_MODE=real INBOUND_MODE=spectrum-local tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "demo": "tsx scripts/demo.ts",
    "live:imessage": "tsx scripts/live-imessage.ts",
    "send-poll:dev": "tsx scripts/send-poll-dev.ts",
    "list:chats": "tsx scripts/list-chats.ts",
    "register:webhook": "tsx scripts/register-webhook.ts",
    "setup:photon": "tsx scripts/setup-photon.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pino": "^9.3.2",
    "uuid": "^10.0.0",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/ws": "^8.18.1",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "optionalDependencies": {
    "@photon-ai/advanced-imessage": "*",
    "@photon-ai/advanced-imessage-kit": "*",
    "@photon-ai/imessage-kit": "*",
    "spectrum-ts": "*"
  }
}
